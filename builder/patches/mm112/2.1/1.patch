diff --git a/AMBuildScript b/AMBuildScript
index bef3d23..dc6455b 100644
--- a/AMBuildScript
+++ b/AMBuildScript
@@ -10,8 +10,7 @@ class CSSDM:
 		#Build SDK info
 		self.sdkInfo = { }
 
-		self.sdkInfo['ep1'] =  {'sdk': 'HL2SDKEP1',     'ext': '1.ep1',  'def': '1',
-		                         'name': 'EPISODEONE',           'platform': ['windows', 'linux']}
+		# MM 1.12 (SM 1.12 / 1.13 lines): no core-legacy (1.ep1); only the 2.ep1 extension is built.
 		self.sdkInfo['ep1_plapi'] =  {'sdk': 'HL2SDKEP1',     'ext': '2.ep1',  'def': '1',
 		                         'name': 'EPISODEONE',           'platform': ['windows', 'linux']}
 
@@ -85,7 +84,11 @@ class CSSDM:
 				self.compiler.AddToListVar('CFLAGS', '-Wno-restrict')
