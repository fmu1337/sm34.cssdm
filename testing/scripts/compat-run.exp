#!/usr/bin/expect -f
# Boot srcds once for the CSS:DM compatibility table: print MM/SM versions and the
# extension/plugin lists, record which ep1 binaries are mapped, let bots play for
# BOT_SECS, list extensions again and quit. Everything goes to COMPAT_LOG.
#   env: SERVER_DIR, COMPAT_LOG, MAPS_FILE, MAP (de_dust2), PORT (27015),
#        SRCDS_BINARY (./srcds_i686), BOT_SECS (90)
foreach {var def} {MAP de_dust2 PORT 27015 SRCDS_BINARY ./srcds_i686 BOT_SECS 90} {
    if {![info exists env($var)] || $env($var) eq ""} { set env($var) $def }
}
foreach var {SERVER_DIR COMPAT_LOG MAPS_FILE} {
    if {![info exists env($var)]} { puts stderr "$var is required"; exit 1 }
}
log_file -noappend $env(COMPAT_LOG)
log_user 0
match_max 100000
set map $env(MAP)

cd $env(SERVER_DIR)
set env(LD_LIBRARY_PATH) ".:bin:[expr {[info exists env(LD_LIBRARY_PATH)] ? $env(LD_LIBRARY_PATH) : {}}]"
spawn $env(SRCDS_BINARY) -game cstrike -console -nohltv -nomaster -localcser -tickrate 66 \
    -ip 127.0.0.1 -port $env(PORT) +ip 127.0.0.1 +sv_lan 1 +maxplayers 16 \
    +log on +sv_logecho 1 +map $map
set pid [exp_pid]

set timeout 150
expect {
    -re "Mapchange to $map|Loading map \"$map\"|Started map \"$map\"" {}
    eof { puts "COMPAT: exited before map"; exit 2 }
    timeout { puts "COMPAT: timeout waiting for map"; exit 2 }
}
sleep 5

proc cmd {line {wait 2}} {
    send "$line\r"
    set timeout $wait
    expect {
        eof { puts "COMPAT: exited after '$line'"; exit 3 }
        timeout {}
    }
}

cmd "meta version"
cmd "sm version"
cmd "echo COMPAT_EXTS_BEGIN"
cmd "sm exts list" 3
cmd "echo COMPAT_PLUGINS_BEGIN"
cmd "sm plugins list" 3
cmd "echo COMPAT_LISTS_END"

if {[catch {exec grep -oE {(metamod|sourcemod|cssdm\.ext)\.[0-9]\.ep1\.so} /proc/$pid/maps} mapped]} {
    set mapped ""
}
set fh [open $env(MAPS_FILE) w]
puts $fh $mapped
close $fh

cmd "bot_join_after_player 0"
cmd "bot_quota_mode fill"
cmd "bot_difficulty 2"
cmd "bot_chatter off"
cmd "bot_quota 8"
cmd "echo COMPAT_BOTS_BEGIN"
cmd "mp_restartgame 1" $env(BOT_SECS)
cmd "echo COMPAT_BOTS_END"
cmd "echo COMPAT_EXTS_AFTER"
cmd "sm exts list" 3
cmd "status" 2

send "quit\r"
set timeout 30
expect {
    eof {}
    timeout {}
}
puts "COMPAT: done"
exit 0
